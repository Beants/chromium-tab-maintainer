{
  "name": "chromium-tab-maintainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint extension scripts tests && node scripts/check.mjs",
    "typecheck": "tsc",
    "coverage": "node --experimental-test-coverage --test-coverage-include='extension/**/*.js' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test tests/*.test.js",
    "package": "node scripts/package.mjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "22.19.0",
    "eslint": "10.14.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "description": "Local-first Manifest V3 tab maintenance for Chromium browsers.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Beants/chromium-tab-maintainer.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
