{
  "manifest_version": 3,
  "name": "Chromium Tab Maintainer · 标签页自动整理",
  "version": "1.0.0",
  "description": "Local tab cleanup, per-repository Git deduplication, sorting, recovery and live progress. Paused by default.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-state.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "打开标签页维护设置"
  },
  "minimum_chrome_version": "121"
}
